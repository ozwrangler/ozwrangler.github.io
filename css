.profile{

display:flex;
align-items:center;
justify-content:center;
gap:80px;
flex-wrap:wrap;

}

.profile-image img{

width:340px;
height:340px;
object-fit:cover;

border-radius:50%;

border:5px solid rgba(255,255,255,.15);

box-shadow:0 30px 80px rgba(0,0,0,.5);

}

.profile-text{

max-width:600px;

}

.profile-text h2{

font-size:3rem;
margin-bottom:15px;

}

.profile-text h3{

color:#999;
margin-bottom:30px;
font-weight:500;

}

.profile-text p{

line-height:1.9;
color:#bbb;

}

.badges{

margin-top:35px;
display:flex;
flex-wrap:wrap;
gap:12px;

}

.badges span{

padding:10px 18px;

background:#111;

border-radius:30px;

border:1px solid #333;

}
